rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Les visiteurs peuvent envoyer un message, mais seul l'admin peut les lire/supprimer
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Configurations (ex: lockdown, SEO, statut)
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Statistiques globales (compteurs)
    match /stats/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Likes du portfolio
    match /likes/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Articles de veille technologique
    match /veille/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Easter eggs et commandes
    match /terminal_commands/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Suivi des visiteurs
    match /visitors/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
